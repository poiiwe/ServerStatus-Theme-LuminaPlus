{
  "name": "serverstatus-theme-luminaplus",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc && vite build",
    "dev": "vite --host",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx,.vue src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vueuse/core": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^5.4.3",
    "lucide-vue-next": "^0.577.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.43",
    "vue-echarts": "^6.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.43.1",
    "@types/node": "^18.18.4",
    "@vitejs/plugin-vue": "^4.4.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.51.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "~5.5.4",
    "unplugin-auto-import": "^0.16.6",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^4.4.11",
    "vue-tsc": "^2.2.12"
  },
  "eslintConfig": {
    "extends": "@antfu",
    "rules": {
      "vue/block-order": [
        "error",
        {
          "order": [
            "template",
            "script",
            "style"
          ]
        }
      ]
    }
  }
}
